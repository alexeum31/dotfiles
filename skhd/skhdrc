# Changing window focus
alt - j : yabai -m window --focus south
alt - k : yabai -m window --focus north
alt - h : yabai -m window --focus west
alt - l : yabai -m window --focus east

# change master width
alt + shift - h : ~/.config/skhd/resizeWindow.sh -h
alt + shift - l : ~/.config/skhd/resizeWindow.sh -l

# change split height
alt + shift - j : ~/.config/skhd/resizeWindow.sh -j
alt + shift - k : ~/.config/skhd/resizeWindow.sh -k

#Changing monitor focus
# Focus previous display by arrangement index
alt - s : yabai -m display --focus prev; yabai -m window --focus mouse

# Focus next display by arrangement index
alt - g : yabai -m display --focus next; yabai -m window --focus mouse

# Swap between adjacent windows
ctrl + alt - h : yabai -m window --swap west
ctrl + alt - l : yabai -m window --swap east
ctrl + alt - k : yabai -m window --swap north
ctrl + alt - j : yabai -m window --swap south
